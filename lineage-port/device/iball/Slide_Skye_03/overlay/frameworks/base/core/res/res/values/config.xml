<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The vibration motor needs tens of milliseconds to spin up; the AOSP
         1 ms and 10 ms pulses are not perceptible. Stock iBall used 30 ms
         for virtual keys (also the click-effect fallback) and 40 ms for
         keyboard taps. -->
    <integer-array name="config_virtualKeyVibePattern">
        <item>0</item>
        <item>30</item>
        <item>60</item>
        <item>90</item>
    </integer-array>

    <integer-array name="config_longPressVibePattern">
        <item>0</item>
        <item>40</item>
    </integer-array>

    <!-- This persistent stock-vendor app requires the stock platform signature
         to contact the modem services. Under LineageOS it only retries and logs
         SELinux denials, so keep it disabled unless explicitly launched. -->
    <string-array name="config_disabledUntilUsedPreinstalledCarrierApps"
                  translatable="false">
        <item>com.android.modemnotifier</item>
    </string-array>
</resources>
